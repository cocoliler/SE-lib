{
  "$defs": {
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "covered_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Covered Ids",
          "type": "array"
        },
        "uncovered_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Uncovered Ids",
          "type": "array"
        }
      },
      "required": [
        "covered_ids",
        "uncovered_ids"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "description": "单条缺陷；path 为 JSON Pointer，例如 /tasks/2/dependencies/0。",
      "properties": {
        "code": {
          "$ref": "#/$defs/IssueCode"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/TaskEdge"
          },
          "maxItems": 200,
          "title": "Edges",
          "type": "array"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "maxLength": 200,
          "pattern": "^(/[^/]*)*$",
          "title": "Path",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        },
        "suggestion": {
          "maxLength": 2000,
          "minLength": 0,
          "title": "Suggestion",
          "type": "string"
        },
        "task_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Task Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "severity",
        "path",
        "message",
        "task_ids",
        "edges",
        "suggestion"
      ],
      "title": "Issue",
      "type": "object"
    },
    "IssueCode": {
      "description": "ValidationReport.errors/warnings 的 code。",
      "enum": [
        "SPEC_REQUIRED",
        "DUPLICATE_ID",
        "MISSING_DEPENDENCY",
        "SELF_DEPENDENCY",
        "DUPLICATE_DEPENDENCY",
        "CYCLE",
        "INVALID_STAGE",
        "INVALID_ROLE",
        "INVALID_CATEGORY",
        "STAGE_EDGE_FORBIDDEN",
        "MISSING_INPUT",
        "INPUT_NOT_DEPENDENCY",
        "UNKNOWN_REQUIREMENT",
        "REQUIRED_UNCOVERED",
        "REQUIRED_CATEGORY",
        "UNCONFIRMED_ASSUMPTION",
        "CRITICAL_ASSUMPTION",
        "POSSIBLE_DUPLICATE",
        "ORPHAN",
        "POLICY_UNSATISFIABLE",
        "SOURCE_MISMATCH"
      ],
      "title": "IssueCode",
      "type": "string"
    },
    "IssueSeverity": {
      "enum": [
        "error",
        "warning"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "TaskEdge": {
      "additionalProperties": false,
      "description": "依赖边 source→target，表示 target 必须等待 source。",
      "properties": {
        "source": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "TaskEdge",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Errors",
      "type": "array"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "rules_version": {
      "const": "1.0",
      "title": "Rules Version",
      "type": "string"
    },
    "valid": {
      "title": "Valid",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "valid",
    "errors",
    "warnings",
    "coverage",
    "rules_version",
    "input_hash"
  ],
  "title": "ValidationReport",
  "type": "object"
}

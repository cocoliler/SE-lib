# FlowStudio v3.1 后端（E 岗位）示例环境变量。复制为 backend/.env 后填写所需配置。启动脚本会自动读取 .env。

# 数据目录（默认 backend/.flowstudio）
FLOWSTUDIO_DATA_DIR=

# 数据库地址（默认 sqlite:///<data_dir>/flowstudio.db）
FLOWSTUDIO_DATABASE_URL=

# 启动时用 Alembic 迁移（1）还是直接 create_all（0，仅测试/快速试跑）
FLOWSTUDIO_USE_ALEMBIC=1

# 单实例文件锁（1 开启；测试可关）
FLOWSTUDIO_INSTANCE_LOCK=1

# 规划队列消费模式：thread（默认）或 inline（同步，测试用）
FLOWSTUDIO_WORKER_MODE=thread

# 队列容量（超出返回 429 QUEUE_FULL）
FLOWSTUDIO_QUEUE_CAPACITY=10

# 默认模型（config.model = "configured-default" 时解析为它）
FLOWSTUDIO_DEFAULT_MODEL=deepseek-flash

# 模型 allowlist，逗号分隔（"configured-default" 恒可用）
FLOWSTUDIO_MODEL_ALLOWLIST=deepseek-flash

# 真实模型密钥：只由服务端读取，绝不下发前端。
DEEPSEEK_API_KEY=

# TEST 模式 fixture 目录（JSON 文件，文件名即 fixture_id）
FLOWSTUDIO_FIXTURES_DIR=

# 前端产物目录（存在时由后端同源提供静态页面，start.ps1 会自动设置）
FLOWSTUDIO_FRONTEND_DIST=

# 允许的 Host（逗号分隔）
FLOWSTUDIO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# 允许的 Origin（逗号分隔）
FLOWSTUDIO_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
